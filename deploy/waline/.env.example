TZ=Asia/Shanghai
SQLITE_PATH=/app/data
JWT_TOKEN=replace-with-a-long-random-string
SITE_NAME=FLmhp's Blog
SITE_URL=https://soloeternity.me
SERVER_URL=https://waline.soloeternity.me
SECURE_DOMAINS=soloeternity.me,waline.soloeternity.me
AUTHOR_EMAIL=your-email@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password-or-app-password
SMTP_SECURE=true
SENDER_NAME=SoloEternity
SENDER_EMAIL=your-email@example.com
MAIL_SUBJECT="{{self.nick}} replied to your comment on {{site.name | safe}}"
MAIL_TEMPLATE="<div style='margin:0;padding:32px 16px;background:#f3f7fb;font:14px/1.75 -apple-system,BlinkMacSystemFont,Segoe UI,sans-serif;color:#1f2937;'><div style='max-width:720px;margin:0 auto;background:#ffffff;border:1px solid #dbe5f0;border-radius:20px;overflow:hidden;box-shadow:0 12px 32px rgba(15,23,42,.08);'><div style='padding:24px 28px;background:linear-gradient(135deg,#0f766e,#14b8a6);color:#ffffff;'><div style='font-size:12px;letter-spacing:.08em;text-transform:uppercase;opacity:.88;'>Waline Reply</div><h2 style='margin:10px 0 0;font-size:24px;line-height:1.35;'>{{parent.nick | safe}}, your comment on {{site.name | safe}} received a reply</h2></div><div style='padding:28px;'><p style='margin:0 0 12px;'>Original comment:</p><div style='padding:16px 18px;background:#f8fafc;border-left:4px solid #94a3b8;border-radius:14px;word-break:break-word;'>{{parent.comment | safe}}</div><p style='margin:20px 0 12px;'>{{self.nick | safe}} replied:</p><div style='padding:16px 18px;background:#ecfeff;border-left:4px solid #14b8a6;border-radius:14px;word-break:break-word;'>{{self.comment | safe}}</div><p style='margin:24px 0 0;'><a href='{{site.postUrl}}' target='_blank' style='display:inline-block;padding:11px 18px;background:#0f766e;color:#ffffff;text-decoration:none;border-radius:999px;'>View the full discussion</a></p><p style='margin:18px 0 0;color:#64748b;font-size:12px;'>This message was sent by the Waline notification service for {{site.name | safe}}.</p></div></div></div>"
MAIL_SUBJECT_ADMIN="{{self.nick}} posted a new comment on {{site.name | safe}}"
MAIL_TEMPLATE_ADMIN="<div style='margin:0;padding:32px 16px;background:#f3f7fb;font:14px/1.75 -apple-system,BlinkMacSystemFont,Segoe UI,sans-serif;color:#1f2937;'><div style='max-width:720px;margin:0 auto;background:#ffffff;border:1px solid #dbe5f0;border-radius:20px;overflow:hidden;box-shadow:0 12px 32px rgba(15,23,42,.08);'><div style='padding:24px 28px;background:linear-gradient(135deg,#1d4ed8,#3b82f6);color:#ffffff;'><div style='font-size:12px;letter-spacing:.08em;text-transform:uppercase;opacity:.88;'>Waline Admin Notice</div><h2 style='margin:10px 0 0;font-size:24px;line-height:1.35;'>{{site.name | safe}} received a new comment</h2></div><div style='padding:28px;'><p style='margin:0 0 12px;'>Comment author: <strong>{{self.nick | safe}}</strong>{% if self.mail %} ({{self.mail}}){% endif %}</p><div style='padding:16px 18px;background:#eff6ff;border-left:4px solid #3b82f6;border-radius:14px;word-break:break-word;'>{{self.comment | safe}}</div><p style='margin:24px 0 0;'><a href='{{site.postUrl}}' target='_blank' style='display:inline-block;padding:11px 18px;background:#1d4ed8;color:#ffffff;text-decoration:none;border-radius:999px;'>Open the comment thread</a></p><p style='margin:18px 0 0;color:#64748b;font-size:12px;'>This message was sent by the Waline notification service for {{site.name | safe}}.</p></div></div></div>"
