(blog_security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
	}
}
www.soloeternity.me {
	import blog_security
	redir https://soloeternity.me{uri} permanent
}
soloeternity.me {
	import blog_security
	tls /etc/caddy/certs/origin.cert.pem /etc/caddy/certs/origin.key.pem {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/certs/aop-root-ca.cert.pem
		}
	}
	encode zstd gzip
	root * /var/www/blog/current
	@immutable path /live2d-models/* /live2d-widget/* /js/aplayer-1.10.1.min.js /css/aplayer-1.10.1.min.css
	@static {
		path *.css *.js *.mjs *.png *.jpg *.jpeg *.gif *.webp *.svg *.ico *.woff *.woff2 *.ttf *.json *.moc3 *.lrc *.xml
		not path /live2d-models/* /live2d-widget/* /js/aplayer-1.10.1.min.js /css/aplayer-1.10.1.min.css
	}
	@html not path *.css *.js *.mjs *.png *.jpg *.jpeg *.gif *.webp *.svg *.ico *.woff *.woff2 *.ttf *.json *.moc3 *.lrc *.xml
	@admin path /admin /admin/*
	@site not path /admin /admin/*
	header @html Cache-Control "public, max-age=0, must-revalidate"
	header @static Cache-Control "public, max-age=3600, s-maxage=604800, stale-while-revalidate=86400"
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	header @site Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://lib.baomitu.com https://fastly.jsdelivr.net https://umami.soloeternity.me https://cdn.busuanzi.cc https://busuanzi.ibruce.info https://busuanzi.9420.ltd https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://at.alicdn.com https://fastly.jsdelivr.net https://lib.baomitu.com; font-src 'self' data: https://fonts.gstatic.com https://at.alicdn.com https://fastly.jsdelivr.net; img-src 'self' data: blob: https:; media-src 'self' blob: https://assets.soloeternity.me; connect-src 'self' https://assets.soloeternity.me https://memos.soloeternity.me https://gallery.soloeternity.me https://api.bgm.tv https://v1.hitokoto.cn https://umami.soloeternity.me https://cdn.busuanzi.cc https://busuanzi.ibruce.info https://busuanzi.9420.ltd; frame-src 'self' https://memos.soloeternity.me; worker-src 'self' blob:; manifest-src 'self'"
	header @admin Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://github.com https://cms-auth.soloeternity.me; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://api.github.com https://github.com https://cms-auth.soloeternity.me https://cloudflareinsights.com; frame-src 'self' https://github.com https://cms-auth.soloeternity.me; worker-src 'self' blob:; manifest-src 'self'"
	file_server
}
