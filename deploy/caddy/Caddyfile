{
    acme_dns cloudflare {env.CF_API_TOKEN}
    layer4 {
        :7000 {
            route {
                proxy frps:7000
            }
        }
    }
}

www.soloeternity.me {
    redir https://soloeternity.me{uri} permanent
}

soloeternity.me {
    encode zstd gzip
    root * /var/www/blog/current
    @static path *.css *.js *.mjs *.png *.jpg *.jpeg *.gif *.webp *.svg *.ico *.woff *.woff2 *.ttf *.json *.moc3 *.lrc *.xml
    header @static Cache-Control "public, max-age=3600, s-maxage=604800, stale-while-revalidate=86400"
    file_server
}

waline.soloeternity.me {
    encode zstd gzip
    reverse_proxy waline:8360
}

umami.soloeternity.me {
    encode zstd gzip
    reverse_proxy umami:3000
}

memos.soloeternity.me {
    encode zstd gzip
    header {
        Access-Control-Allow-Origin https://soloeternity.me
        Access-Control-Allow-Methods "GET, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization"
        Vary Origin
    }
    @cors_preflight method OPTIONS
    respond @cors_preflight 204
    reverse_proxy memos:5230
}

chat.soloeternity.me {
    encode zstd gzip
    reverse_proxy lobehub:3210
}

s3.soloeternity.me {
    reverse_proxy seaweedfs-s3:8333
}

openlist.soloeternity.me {
    encode zstd gzip
    reverse_proxy openlist:5244
}

gallery.soloeternity.me {
    encode zstd gzip
    header {
        Access-Control-Allow-Origin https://soloeternity.me
        Vary Origin
    }
    reverse_proxy chevereto:8080
}

assets.soloeternity.me {
    respond "assets.soloeternity.me should be bound to Cloudflare R2, not this server." 404
}

cms-auth.soloeternity.me {
    respond "cms-auth.soloeternity.me is reserved for Decap CMS OAuth." 404
}

